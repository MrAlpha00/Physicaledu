# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# CLOUDFLARE R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# RESEND
# Server-only. Leave empty to use in-app notifications without email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Required to verify signed delivery/bounce webhooks. Never prefix with NEXT_PUBLIC_.
RESEND_WEBHOOK_SECRET=

# CLOUDFLARE TURNSTILE (OPTIONAL)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SCHEDULED JOBS (SERVER ONLY)
# Shared secret for /api/cron/games/timeouts. Leave empty to disable the endpoint.
CRON_SECRET=

# APPLICATION
NEXT_PUBLIC_SITE_URL=

# RESERVED / PLATFORM-PROVIDED
# Vercel sets this automatically for preview/production deployments. It is not a secret.
VERCEL_URL=